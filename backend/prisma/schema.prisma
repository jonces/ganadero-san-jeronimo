generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TRABAJADOR
}

enum Sexo {
  MACHO
  HEMBRA
}

enum TipoEvento {
  VACUNACION
  TRATAMIENTO
  PESAJE
  PARTO
  OBSERVACION
  MOVIMIENTO
}

enum TipoDocumento {
  FIERRO_ANUAL
  PERMISO_ALCALDIA
  CARTA_VENTA
  OTRO
}

enum TipoVenta {
  EN_PIE
  POR_PESO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  CREDITO
}

enum EstadoPago {
  PAGADO
  PENDIENTE
  PARCIAL
}

model Finca {
  id           String   @id @default(uuid())
  nombre       String
  ubicacion    String?
  tipoCambio          Float    @default(36.5)
  activa              Boolean  @default(true)
  plan                String   @default("GRATUITO")
  precioLibra         Float    @default(85)
  precioReproductora  Float    @default(29000)
  metaAnimales        Int      @default(150)
  createdAt    DateTime @default(now())

  usuarios    Usuario[]
  animales    Animal[]
  documentos  Documento[]
  ventas      Venta[]
  incidentes  Incidente[]
  gastos      Gasto[]
  anuncios      Anuncio[]
  actividadLogs ActividadLog[]
  tareas        Tarea[]
  compras          Compra[]
  proveedores      Proveedor[]
  cuentasPorPagar  CuentaPorPagar[]
  insumos          Insumo[]
  cuentasFinancieras   CuentaFinanciera[]
  movimientosFinancieros MovimientoFinanciero[]
  transferenciasInternas TransferenciaInterna[]
  activosFijos         ActivoFijo[]
  valuaciones          ValuacionActivo[]
  prestamos            Prestamo[]
  periodosFinancieros  PeriodoFinanciero[]
  informesFinancieros  InformeFinanciero[]
  auditoriaFinanciera  AuditoriaFinanciera[]
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  role         Role     @default(TRABAJADOR)
  fincaId      String
  finca        Finca    @relation(fields: [fincaId], references: [id])
  resetCodigo  String?
  resetExpira  DateTime?
  fotoPerfil   String?
  cargo           String?  // GERENTE_GENERAL, ADMINISTRADOR, RESPONSABLE_NOMINA, TRABAJADOR_CAMPO, VAQUERO, OTRO
  finanzasPin     String?
  lastSeen        DateTime?
  tokenVersion    Int      @default(0)
  createdAt       DateTime @default(now())

  eventos    Evento[]
  ventas     Venta[]
  incidentes Incidente[]
  gastos     Gasto[]
  anuncios      Anuncio[]
  comentarios   Comentario[]
  actividadLogs ActividadLog[]
  tareas        Tarea[]
}

model Animal {
  id              String    @id @default(uuid())
  identificador   String    @unique
  nombre          String?
  raza            String?
  fierro          String?
  sexo            Sexo
  fechaNacimiento DateTime?
  pesoActual      Float?
  observacion     String?
  estadoComercial String    @default("NO_DISPONIBLE") // NO_DISPONIBLE, EN_VENTA, RESERVADO, VENTA_EN_PROCESO, VENTA_COMPLETADA, SEMENTAL
  potrero         String?
  costoCompra     Float?    // Precio pagado para adquirirlo
  precioVenta     Float?    // Precio al que se quiere vender
  origen          String    @default("FINCA") // FINCA, COMPRADO
  categoria       String?   // CRIA, TERNERO, TERNERA, TORO, VACA, SEMENTAL
  estado          String    @default("ACTIVO")
  enPlanVenta     Boolean   @default(false)   // agregado manualmente al plan de venta
  // Estado reproductivo (solo hembras)
  estadoReproductivo String? // PREÑADA, PARIDA, LACTANCIA, SECA, VACIA - sync v2
  fechaParto         DateTime?
  fechaSecado        DateTime?
  madreId            String?
  madre              Animal?   @relation("Crias", fields: [madreId], references: [id])
  crias              Animal[]  @relation("Crias")
  fincaId         String
  finca           Finca     @relation(fields: [fincaId], references: [id])
  createdAt       DateTime  @default(now())

  eventos    Evento[]
  media      Media[]
  ventas     Venta[]
  incidentes Incidente[]
  tareas     TareaAnimal[]
  publicacion PublicacionVenta?
  reservas    Reserva[]
}

model Evento {
  id          String     @id @default(uuid())
  tipo        TipoEvento
  descripcion String?
  peso        Float?
  fecha       DateTime   @default(now())
  animalId    String
  animal      Animal     @relation(fields: [animalId], references: [id])
  usuarioId   String
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])

  media Media[]
}

model Media {
  id        String   @id @default(uuid())
  url       String
  tipo      String
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id])
  eventoId  String?
  evento    Evento?  @relation(fields: [eventoId], references: [id])
  ventaId      String?
  venta        Venta?     @relation(fields: [ventaId], references: [id])
  incidenteId  String?
  incidente    Incidente? @relation(fields: [incidenteId], references: [id])
  gastoId   String?
  gasto     Gasto?   @relation(fields: [gastoId], references: [id])
  createdAt DateTime @default(now())
}

model Incidente {
  id          String   @id @default(uuid())
  tipo        String   // ACCIDENTE, ENFERMEDAD, MUERTE, OTRO
  gravedad    String   @default("LEVE") // LEVE, MODERADA, GRAVE, CRITICA
  estado      String   @default("ACTIVO") // ACTIVO, RESUELTO
  descripcion String
  tratamiento String?
  animalId    String?
  animal      Animal?  @relation(fields: [animalId], references: [id])
  fincaId     String
  finca       Finca    @relation(fields: [fincaId], references: [id])
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  media       Media[]
}

model Gasto {
  id           String   @id @default(uuid())
  descripcion  String
  categoria    String
  monto        Float
  moneda       String   @default("NIO")
  tipoCambio   Float?
  periodicidad String
  fecha        DateTime @default(now())
  notas        String?
  responsable  String?
  receptor     String?
  fincaId      String
  finca        Finca    @relation(fields: [fincaId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt    DateTime @default(now())
  media        Media[]
}

model Documento {
  id        String        @id @default(uuid())
  nombre    String
  tipo      TipoDocumento
  url       String
  notas     String?
  fincaId   String
  finca     Finca         @relation(fields: [fincaId], references: [id])
  createdAt DateTime      @default(now())
}

model Venta {
  id            String     @id @default(uuid())
  tipoVenta     TipoVenta
  moneda        String     @default("NIO")
  tipoCambio    Float      @default(36.5)
  precioNIO     Float
  precioUSD     Float
  pesoKg        Float?
  unidadPeso    String     @default("LB")
  precioKg      Float?
  metodoPago    MetodoPago @default(EFECTIVO)
  estadoPago    EstadoPago @default(PAGADO)
  numeroFactura String?
  comision      Float?
  descuento     Float?
  impuestos     Float?
  comprador     String?
  telefonoComprador String?
  direccionComprador String?
  notas         String?
  fechaSalida       DateTime?
  pesoFinal         Float?
  adelantoAplicado  Float?    @default(0)
  saldoPendiente    Float?    @default(0)
  estadoVenta       String    @default("CONFIRMADA") // PROCESO, CONFIRMADA, REVERSADA
  reservaId         String?
  motivoRevision    String?
  pesoVivo             Float?
  compradorIdentificacion String?
  vendedorIdentificacion  String?
  vendedorTelefono        String?
  vendedorDireccion       String?
  numeroCarta             Int?
  fecha         DateTime   @default(now())
  animalId      String
  animal        Animal     @relation(fields: [animalId], references: [id])
  fincaId       String
  finca         Finca      @relation(fields: [fincaId], references: [id])
  usuarioId     String
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  createdAt     DateTime   @default(now())

  media         Media[]
}

model Anuncio {
  id          String       @id @default(uuid())
  titulo      String
  mensaje     String
  emoji       String       @default("📢")
  fincaId     String
  finca       Finca        @relation(fields: [fincaId], references: [id])
  autorId     String
  autor       Usuario      @relation(fields: [autorId], references: [id])
  comentarios Comentario[]
  createdAt   DateTime     @default(now())
}

model Comentario {
  id         String   @id @default(uuid())
  mensaje    String
  anuncioId  String
  anuncio    Anuncio  @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  autorId    String
  autor      Usuario  @relation(fields: [autorId], references: [id])
  createdAt  DateTime @default(now())
}

model Tarea {
  id          String        @id @default(uuid())
  tipo        String        // VACUNACION, TRATAMIENTO, DESPARASITACION, PESAJE, INSEMINACION, DESTETE, OTRO
  descripcion String?
  fecha       DateTime
  estado      String        @default("PENDIENTE") // PENDIENTE, COMPLETADA
  fincaId     String
  finca       Finca         @relation(fields: [fincaId], references: [id])
  creadoPor   String
  creador     Usuario       @relation(fields: [creadoPor], references: [id])
  animales    TareaAnimal[]
  createdAt   DateTime      @default(now())
}

model TareaAnimal {
  id       String @id @default(uuid())
  tareaId  String
  tarea    Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id])
}

model PublicacionVenta {
  id              String   @id @default(uuid())
  animalId        String   @unique
  animal          Animal   @relation(fields: [animalId], references: [id])
  precio          Float
  moneda          String   @default("NIO")
  modalidad       String   @default("TOTAL") // TOTAL, POR_KG, POR_LIBRA
  precioPorUnidad Float?
  negociable      Boolean  @default(false)
  descripcion     String?
  publicada       Boolean  @default(true)
  fechaPublicacion DateTime?
  contacto        String?
  whatsapp        String?
  ubicacion       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Reserva {
  id               String   @id @default(uuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id])
  cliente          String
  telefono         String?
  identificacion   String?
  precioAcordado   Float
  adelanto         Float    @default(0)
  metodoPago       String   @default("EFECTIVO")
  fechaReserva     DateTime @default(now())
  fechaVencimiento DateTime?
  estado           String   @default("ACTIVA") // ACTIVA, CANCELADA, VENCIDA, COMPLETADA
  motivoCancelacion String?
  adelantoDevuelto Boolean  @default(false)
  responsableId    String?
  notas            String?
  fincaId          String
  createdAt        DateTime @default(now())
}

model ActividadLog {
  id        String   @id @default(uuid())
  accion    String
  detalle   String?
  modulo    String
  fincaId   String
  finca     Finca    @relation(fields: [fincaId], references: [id])
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
}

model Compra {
  id          String   @id @default(cuid())
  fincaId     String
  finca       Finca    @relation(fields: [fincaId], references: [id])
  tipo        String   // ANIMAL, INSUMO, EQUIPO, SERVICIO, OTRO
  descripcion String
  proveedor   String?
  cantidad    Float    @default(1)
  precioUnit  Float
  total        Float
  pagadoDeCaja Float    @default(0) // cuánto de esta compra salió de la caja disponible
  fecha        DateTime @default(now())
  factura      String?
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Proveedor {
  id        String   @id @default(cuid())
  fincaId   String
  finca     Finca    @relation(fields: [fincaId], references: [id])
  nombre    String
  tipo      String   // VETERINARIA, ALIMENTACION, EQUIPO, TRANSPORTE, FINANCIERO, OTRO
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CuentaPorPagar {
  id          String    @id @default(cuid())
  fincaId     String
  finca       Finca     @relation(fields: [fincaId], references: [id])
  descripcion String
  proveedor   String?
  monto       Float
  fechaVence  DateTime
  estado      String    @default("PENDIENTE")
  pagadaEn    DateTime?
  notas       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Insumo {
  id          String   @id @default(cuid())
  fincaId     String
  finca       Finca    @relation(fields: [fincaId], references: [id])
  nombre      String
  categoria   String
  unidad      String
  stockActual Float    @default(0)
  stockMinimo Float    @default(0)
  precioUnit  Float?
  proveedor   String?
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── MÓDULO FINANCIERO PROFESIONAL ───────────────────────────────────────────

model CuentaFinanciera {
  id             String   @id @default(cuid())
  fincaId        String
  finca          Finca    @relation(fields: [fincaId], references: [id])
  nombre         String
  tipo           String   // CAJA, CAJA_CHICA, BANCO
  banco          String?
  moneda         String   @default("NIO")
  ultimosCuatro  String?
  saldoInicial   Decimal  @default(0) @db.Decimal(15,2)
  saldoActual    Decimal  @default(0) @db.Decimal(15,2)
  estado         String   @default("ACTIVA")
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimientos           MovimientoFinanciero[]
  transferenciasOrigen  TransferenciaInterna[] @relation("CuentaOrigen")
  transferenciasDestino TransferenciaInterna[] @relation("CuentaDestino")
}

model MovimientoFinanciero {
  id            String   @id @default(cuid())
  fincaId       String
  finca         Finca    @relation(fields: [fincaId], references: [id])
  cuentaId      String?
  cuenta        CuentaFinanciera? @relation(fields: [cuentaId], references: [id])
  tipo          String   // INGRESO, EGRESO
  categoria     String?
  concepto      String
  monto         Decimal  @db.Decimal(15,2)
  moneda        String   @default("NIO")
  tipoCambio    Decimal? @db.Decimal(10,4)
  montoNIO      Decimal? @db.Decimal(15,2)
  fecha         DateTime @default(now())
  referencia    String?
  comprobante   String?
  sourceType    String?  // VENTA, GASTO, COMPRA, CUENTA_POR_PAGAR, PAGO_PRESTAMO, TRANSFERENCIA, MANUAL
  sourceId      String?
  usuarioId     String
  observaciones String?
  anulado       Boolean  @default(false)
  motivoAnulacion String?
  createdAt     DateTime @default(now())

  @@index([fincaId, fecha])
  @@index([fincaId, sourceType, sourceId])
}

model TransferenciaInterna {
  id               String   @id @default(cuid())
  fincaId          String
  finca            Finca    @relation(fields: [fincaId], references: [id])
  cuentaOrigenId   String
  cuentaOrigen     CuentaFinanciera @relation("CuentaOrigen", fields: [cuentaOrigenId], references: [id])
  cuentaDestinoId  String
  cuentaDestino    CuentaFinanciera @relation("CuentaDestino", fields: [cuentaDestinoId], references: [id])
  monto            Decimal  @db.Decimal(15,2)
  moneda           String   @default("NIO")
  concepto         String?
  fecha            DateTime @default(now())
  usuarioId        String
  createdAt        DateTime @default(now())
}

model ActivoFijo {
  id                  String   @id @default(cuid())
  fincaId             String
  finca               Finca    @relation(fields: [fincaId], references: [id])
  codigo              String?
  nombre              String
  categoria           String   // TERRENO, VEHICULO, MAQUINARIA, INFRAESTRUCTURA, EQUIPO, HERRAMIENTA, SISTEMA_SOLAR, CORRAL, BODEGA, OTRO
  descripcion         String?
  fechaAdquisicion    DateTime?
  costoAdquisicion    Decimal? @db.Decimal(15,2)
  monedaAdquisicion   String   @default("NIO")
  valorActual         Decimal? @db.Decimal(15,2)
  metodoValoracion    String?  // COSTO_HISTORICO, VALOR_MERCADO, PERICIAL
  fechaUltimaValuacion DateTime?
  estado              String   @default("ACTIVO") // ACTIVO, VENDIDO, BAJA
  ubicacion           String?
  proveedor           String?
  numeroDocumento     String?
  documentoUrl        String?
  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  valuaciones ValuacionActivo[]
}

model ValuacionActivo {
  id            String     @id @default(cuid())
  fincaId       String
  finca         Finca      @relation(fields: [fincaId], references: [id])
  activoId      String?
  activo        ActivoFijo? @relation(fields: [activoId], references: [id])
  tipo          String     // GANADO_HATO, ACTIVO_FIJO, ANIMAL_INDIVIDUAL
  referenciaId  String?
  fecha         DateTime   @default(now())
  metodo        String     // PESO_PRECIO, VALOR_MERCADO, PERICIAL, COSTO_HISTORICO
  valorAnterior Decimal?   @db.Decimal(15,2)
  valorNuevo    Decimal    @db.Decimal(15,2)
  moneda        String     @default("NIO")
  supuestos     String?
  notas         String?
  usuarioId     String
  esRealizada   Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model Prestamo {
  id             String   @id @default(cuid())
  fincaId        String
  finca          Finca    @relation(fields: [fincaId], references: [id])
  acreedor       String
  institucion    String?
  tipo           String   // HIPOTECARIO, PERSONAL, COMERCIAL, LINEA_CREDITO, OTRO
  referencia     String?
  fechaInicio    DateTime
  montoOriginal  Decimal  @db.Decimal(15,2)
  moneda         String   @default("NIO")
  saldoActual    Decimal  @db.Decimal(15,2)
  tasaInteres    Decimal? @db.Decimal(6,4)
  tipoTasa       String?  // FIJA, VARIABLE
  plazoMeses     Int?
  cuotaMensual   Decimal? @db.Decimal(15,2)
  frecuencia     String   @default("MENSUAL")
  proximaCuota   DateTime?
  vencimiento    DateTime?
  garantia       String?
  proposito      String?
  estado         String   @default("ACTIVO") // ACTIVO, PAGADO, VENCIDO, REFINANCIADO, CANCELADO
  documentoUrl   String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cuotas CuotaPrestamo[]

  @@index([fincaId, estado])
}

model CuotaPrestamo {
  id           String   @id @default(cuid())
  prestamoId   String
  prestamo     Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numeroCuota  Int
  fechaVence   DateTime
  capital      Decimal  @db.Decimal(15,2)
  interes      Decimal  @db.Decimal(15,2)
  otrosCargos  Decimal  @default(0) @db.Decimal(15,2)
  total        Decimal  @db.Decimal(15,2)
  saldo        Decimal  @db.Decimal(15,2)
  estado       String   @default("PENDIENTE") // PENDIENTE, PAGADA, VENCIDA
  fechaPago    DateTime?
  createdAt    DateTime @default(now())
}

model PeriodoFinanciero {
  id          String   @id @default(cuid())
  fincaId     String
  finca       Finca    @relation(fields: [fincaId], references: [id])
  anio        Int
  mes         Int
  tipo        String   @default("MENSUAL") // MENSUAL, ANUAL
  estado      String   @default("ABIERTO") // ABIERTO, CERRADO
  ingresos    Decimal? @db.Decimal(15,2)
  gastos      Decimal? @db.Decimal(15,2)
  flujoNeto   Decimal? @db.Decimal(15,2)
  activos     Decimal? @db.Decimal(15,2)
  pasivos     Decimal? @db.Decimal(15,2)
  patrimonio  Decimal? @db.Decimal(15,2)
  cerradoPor  String?
  cerradoEn   DateTime?
  reabiertoPor String?
  reabiertaEn  DateTime?
  motivoReapertura String?
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fincaId, anio, mes, tipo])
  @@index([fincaId, estado])
}

model InformeFinanciero {
  id               String   @id @default(cuid())
  fincaId          String
  finca            Finca    @relation(fields: [fincaId], references: [id])
  codigo           String   @unique
  tipo             String   @default("EXPEDIENTE_BANCARIO")
  empresa          String?
  institucion      String?
  montoSolicitado  Decimal? @db.Decimal(15,2)
  monedaSolicitud  String   @default("NIO")
  plazoMeses       Int?
  destinoCredito   String?
  periodoDesde     DateTime
  periodoHasta     DateTime
  moneda           String   @default("NIO")
  documentosIncluidos Json?
  parametros       Json?
  estado           String   @default("BORRADOR") // BORRADOR, GENERADO, ANULADO
  token            String   @unique @default(cuid())
  usuarioId        String
  generadoEn       DateTime?
  anulado          Boolean  @default(false)
  anuladoPor       String?
  anuladoEn        DateTime?
  motivoAnulacion  String?
  createdAt        DateTime @default(now())

  versiones VersionInforme[]

  @@index([fincaId, estado])
}

model VersionInforme {
  id         String   @id @default(cuid())
  informeId  String
  informe    InformeFinanciero @relation(fields: [informeId], references: [id])
  version    Int
  pdfUrl     String?
  excelUrl   String?
  snapshot   Json?
  usuarioId  String
  createdAt  DateTime @default(now())
}

model AuditoriaFinanciera {
  id            String   @id @default(cuid())
  fincaId       String
  finca         Finca    @relation(fields: [fincaId], references: [id])
  usuarioId     String
  entidad       String
  entidadId     String?
  accion        String   // CREAR, MODIFICAR, ANULAR, CERRAR, REABRIR, GENERAR_INFORME
  valorAnterior Json?
  valorNuevo    Json?
  motivo        String?
  createdAt     DateTime @default(now())

  @@index([fincaId, createdAt])
  @@index([entidad, entidadId])
}
